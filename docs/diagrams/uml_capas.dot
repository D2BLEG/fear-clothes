 CuentaController -> UsuarioService [arrowhead=vee];
 AdminController -> CatalogoService [arrowhead=vee];
 AdminController -> PublicacionService [arrowhead=vee];
 AdminController -> UsuarioService [arrowhead=vee];
 SubastaScheduler -> PublicacionService [arrowhead=vee];
 UsuarioService -> UsuarioRepository [arrowhead=vee];
 UsuarioDetailsService -> UsuarioRepository [arrowhead=vee];
 CatalogoService -> MarcaRepository [arrowhead=vee];
 CatalogoService -> TallaRepository [arrowhead=vee];
 CatalogoService -> PrendaRepository [arrowhead=vee];
 PublicacionService -> PublicacionRepository [arrowhead=vee];
 PublicacionService -> PujaRepository [arrowhead=vee];
 PublicacionService -> OrdenRepository [arrowhead=vee];
 PublicacionService -> MarcaRepository [arrowhead=vee];
 PublicacionService -> TallaRepository [arrowhead=vee];
 PublicacionService -> AlmacenArchivos [arrowhead=vee];
 AlmacenLocal -> AlmacenArchivos [arrowhead=empty, style=dashed];
 PublicacionService -> Estrategias [arrowhead=vee, style=dashed];
 UsuarioRepository -> Entidades [arrowhead=vee, style=dashed];
 MarcaRepository -> Entidades [arrowhead=vee, style=dashed];
 TallaRepository -> Entidades [arrowhead=vee, style=dashed];
 PrendaRepository -> Entidades [arrowhead=vee, style=dashed];
 PublicacionRepository -> Entidades [arrowhead=vee, style=dashed];
 PujaRepository -> Entidades [arrowhead=vee, style=dashed];
 OrdenRepository -> Entidades [arrowhead=vee, style=dashed];
 Entidades -> BD [arrowhead=vee, label=" JPA / Hibernate "];
