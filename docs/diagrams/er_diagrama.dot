digraph ER {
  graph [rankdir=TB, splines=true, nodesep=0.55, ranksep=1.0, fontname="Helvetica", bgcolor="white", pad=0.4, dpi=200, label=<<B>FEAR Clothes — Modelo Entidad-Relación (13 tablas)</B><BR/><FONT POINT-SIZE="11">PK = llave primaria · FK = llave foránea · UQ = único · herencia JOINED: las tablas claras comparten PK con su tabla padre</FONT>>, labelloc=t, fontsize=20];
  node [fontname="Helvetica", fontsize=12];
  edge [fontname="Helvetica", fontsize=10, color="#444444", dir=both, arrowtail=tee, penwidth=1.3];
  usuarios [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#444444"><TR><TD COLSPAN="3" BGCOLOR="#1f4e79"><FONT COLOR="white"><B>usuarios</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fff7d6"><FONT POINT-SIZE="10" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#fff7d6">id</TD><TD ALIGN="LEFT" BGCOLOR="#fff7d6"><FONT COLOR="#666666" POINT-SIZE="11">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT">nombre</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="11">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">UQ</FONT></TD><TD ALIGN="LEFT">email</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="11">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT">password</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="11">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT">activo</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="11">BOOLEAN</FONT></TD></TR></TABLE>>];
  compradores [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#444444"><TR><TD COLSPAN="3" BGCOLOR="#5b8bb8"><FONT COLOR="white"><B>compradores</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fff7d6"><FONT POINT-SIZE="10" COLOR="#555555">PK,FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#fff7d6">id</TD><TD ALIGN="LEFT" BGCOLOR="#fff7d6"><FONT COLOR="#666666" POINT-SIZE="11">BIGINT</FONT></TD></TR></TABLE>>];
  vendedores [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#444444"><TR><TD COLSPAN="3" BGCOLOR="#5b8bb8"><FONT COLOR="white"><B>vendedores</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fff7d6"><FONT POINT-SIZE="10" COLOR="#555555">PK,FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#fff7d6">id</TD><TD ALIGN="LEFT" BGCOLOR="#fff7d6"><FONT COLOR="#666666" POINT-SIZE="11">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT">nombre_tienda</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="11">VARCHAR(255)</FONT></TD></TR></TABLE>>];
  administradores [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#444444"><TR><TD COLSPAN="3" BGCOLOR="#5b8bb8"><FONT COLOR="white"><B>administradores</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fff7d6"><FONT POINT-SIZE="10" COLOR="#555555">PK,FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#fff7d6">id</TD><TD ALIGN="LEFT" BGCOLOR="#fff7d6"><FONT COLOR="#666666" POINT-SIZE="11">BIGINT</FONT></TD></TR></TABLE>>];
  marcas [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#444444"><TR><TD COLSPAN="3" BGCOLOR="#7a5195"><FONT COLOR="white"><B>marcas</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fff7d6"><FONT POINT-SIZE="10" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#fff7d6">id</TD><TD ALIGN="LEFT" BGCOLOR="#fff7d6"><FONT COLOR="#666666" POINT-SIZE="11">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">UQ</FONT></TD><TD ALIGN="LEFT">nombre</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="11">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT">pais</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="11">VARCHAR(255)</FONT></TD></TR></TABLE>>];
  tallas [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#444444"><TR><TD COLSPAN="3" BGCOLOR="#7a5195"><FONT COLOR="white"><B>tallas</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fff7d6"><FONT POINT-SIZE="10" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#fff7d6">id</TD><TD ALIGN="LEFT" BGCOLOR="#fff7d6"><FONT COLOR="#666666" POINT-SIZE="11">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">UQ</FONT></TD><TD ALIGN="LEFT">etiqueta</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="11">VARCHAR(255)</FONT></TD></TR></TABLE>>];
  prendas [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#444444"><TR><TD COLSPAN="3" BGCOLOR="#2e7d32"><FONT COLOR="white"><B>prendas</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fff7d6"><FONT POINT-SIZE="10" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#fff7d6">id</TD><TD ALIGN="LEFT" BGCOLOR="#fff7d6"><FONT COLOR="#666666" POINT-SIZE="11">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT">nombre</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="11">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT">descripcion</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="11">VARCHAR(1000)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT">color</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="11">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT">imagen_url</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="11">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT">categoria</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="11">ENUM</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT">condicion</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="11">ENUM</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eef3fb"><FONT POINT-SIZE="10" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#eef3fb">marca_id</TD><TD ALIGN="LEFT" BGCOLOR="#eef3fb"><FONT COLOR="#666666" POINT-SIZE="11">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eef3fb"><FONT POINT-SIZE="10" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#eef3fb">talla_id</TD><TD ALIGN="LEFT" BGCOLOR="#eef3fb"><FONT COLOR="#666666" POINT-SIZE="11">BIGINT</FONT></TD></TR></TABLE>>];
  calzados [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#444444"><TR><TD COLSPAN="3" BGCOLOR="#6fae73"><FONT COLOR="white"><B>calzados</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fff7d6"><FONT POINT-SIZE="10" COLOR="#555555">PK,FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#fff7d6">id</TD><TD ALIGN="LEFT" BGCOLOR="#fff7d6"><FONT COLOR="#666666" POINT-SIZE="11">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT">silueta</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="11">VARCHAR(255)</FONT></TD></TR></TABLE>>];
  camisetas [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#444444"><TR><TD COLSPAN="3" BGCOLOR="#6fae73"><FONT COLOR="white"><B>camisetas</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fff7d6"><FONT POINT-SIZE="10" COLOR="#555555">PK,FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#fff7d6">id</TD><TD ALIGN="LEFT" BGCOLOR="#fff7d6"><FONT COLOR="#666666" POINT-SIZE="11">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT">tipo_cuello</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="11">VARCHAR(255)</FONT></TD></TR></TABLE>>];
  chamarras [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#444444"><TR><TD COLSPAN="3" BGCOLOR="#6fae73"><FONT COLOR="white"><B>chamarras</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fff7d6"><FONT POINT-SIZE="10" COLOR="#555555">PK,FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#fff7d6">id</TD><TD ALIGN="LEFT" BGCOLOR="#fff7d6"><FONT COLOR="#666666" POINT-SIZE="11">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT">impermeable</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="11">BOOLEAN</FONT></TD></TR></TABLE>>];
  publicaciones [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#444444"><TR><TD COLSPAN="3" BGCOLOR="#c0392b"><FONT COLOR="white"><B>publicaciones</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fff7d6"><FONT POINT-SIZE="10" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#fff7d6">id</TD><TD ALIGN="LEFT" BGCOLOR="#fff7d6"><FONT COLOR="#666666" POINT-SIZE="11">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eef3fb"><FONT POINT-SIZE="10" COLOR="#555555">FK,UQ</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#eef3fb">prenda_id</TD><TD ALIGN="LEFT" BGCOLOR="#eef3fb"><FONT COLOR="#666666" POINT-SIZE="11">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eef3fb"><FONT POINT-SIZE="10" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#eef3fb">vendedor_id</TD><TD ALIGN="LEFT" BGCOLOR="#eef3fb"><FONT COLOR="#666666" POINT-SIZE="11">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT">tipo</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="11">ENUM</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT">precio</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="11">DECIMAL(12,2)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT">fecha_cierre</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="11">DATETIME</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT">estado</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="11">ENUM</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT">fecha_creacion</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="11">DATETIME</FONT></TD></TR></TABLE>>];
  pujas [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#444444"><TR><TD COLSPAN="3" BGCOLOR="#d98e04"><FONT COLOR="white"><B>pujas</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fff7d6"><FONT POINT-SIZE="10" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#fff7d6">id</TD><TD ALIGN="LEFT" BGCOLOR="#fff7d6"><FONT COLOR="#666666" POINT-SIZE="11">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eef3fb"><FONT POINT-SIZE="10" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#eef3fb">publicacion_id</TD><TD ALIGN="LEFT" BGCOLOR="#eef3fb"><FONT COLOR="#666666" POINT-SIZE="11">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eef3fb"><FONT POINT-SIZE="10" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#eef3fb">postor_id</TD><TD ALIGN="LEFT" BGCOLOR="#eef3fb"><FONT COLOR="#666666" POINT-SIZE="11">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT">monto</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="11">DECIMAL(12,2)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT">fecha</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="11">DATETIME</FONT></TD></TR></TABLE>>];
  ordenes [shape=plain label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="5" COLOR="#444444"><TR><TD COLSPAN="3" BGCOLOR="#d98e04"><FONT COLOR="white"><B>ordenes</B></FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#fff7d6"><FONT POINT-SIZE="10" COLOR="#555555">PK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#fff7d6">id</TD><TD ALIGN="LEFT" BGCOLOR="#fff7d6"><FONT COLOR="#666666" POINT-SIZE="11">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eef3fb"><FONT POINT-SIZE="10" COLOR="#555555">FK</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#eef3fb">comprador_id</TD><TD ALIGN="LEFT" BGCOLOR="#eef3fb"><FONT COLOR="#666666" POINT-SIZE="11">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT" BGCOLOR="#eef3fb"><FONT POINT-SIZE="10" COLOR="#555555">FK,UQ</FONT></TD><TD ALIGN="LEFT" BGCOLOR="#eef3fb">publicacion_id</TD><TD ALIGN="LEFT" BGCOLOR="#eef3fb"><FONT COLOR="#666666" POINT-SIZE="11">BIGINT</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT">precio_final</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="11">DECIMAL(12,2)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT">metodo_pago</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="11">VARCHAR(255)</FONT></TD></TR><TR><TD ALIGN="LEFT"><FONT POINT-SIZE="10" COLOR="#555555">&nbsp;</FONT></TD><TD ALIGN="LEFT">fecha</TD><TD ALIGN="LEFT"><FONT COLOR="#666666" POINT-SIZE="11">DATETIME</FONT></TD></TR></TABLE>>];
  usuarios -> compradores [arrowhead=teeodot, label=" id ", fontcolor="#333333"];
  usuarios -> vendedores [arrowhead=teeodot, label=" id ", fontcolor="#333333"];
  usuarios -> administradores [arrowhead=teeodot, label=" id ", fontcolor="#333333"];
  prendas -> calzados [arrowhead=teeodot, label=" id ", fontcolor="#333333"];
  prendas -> camisetas [arrowhead=teeodot, label=" id ", fontcolor="#333333"];
  prendas -> chamarras [arrowhead=teeodot, label=" id ", fontcolor="#333333"];
  marcas -> prendas [arrowhead=crowodot, label=" marca_id ", fontcolor="#333333"];
  tallas -> prendas [arrowhead=crowodot, label=" talla_id ", fontcolor="#333333"];
  prendas -> publicaciones [arrowhead=teeodot, label=" prenda_id ", fontcolor="#333333"];
  usuarios -> publicaciones [arrowhead=crowodot, label=" vendedor_id ", fontcolor="#333333"];
  publicaciones -> pujas [arrowhead=crowodot, label=" publicacion_id ", fontcolor="#333333"];
  usuarios -> pujas [arrowhead=crowodot, label=" postor_id ", fontcolor="#333333"];
  usuarios -> ordenes [arrowhead=crowodot, label=" comprador_id ", fontcolor="#333333"];
  publicaciones -> ordenes [arrowhead=teeodot, label=" publicacion_id ", fontcolor="#333333"];
}
