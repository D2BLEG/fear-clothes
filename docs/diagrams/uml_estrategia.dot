digraph G {
 graph [rankdir=BT, nodesep=0.45, ranksep=0.8, fontname="Helvetica", bgcolor="white", pad=0.4, dpi=170, labelloc=t, fontsize=20, label=<<B>FEAR Clothes — Patrón Strategy (TipoVenta) con Template Method y Factory</B>>];
 node [shape=plain, fontname="Helvetica", fontsize=11];
 edge [fontname="Helvetica", fontsize=10, color="#333333"];
 TipoVenta [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#333333" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#fff2b3" ALIGN="CENTER"><FONT POINT-SIZE="10">&lt;&lt;interface&gt;&gt;<BR/></FONT><B>TipoVenta</B></TD></TR><HR/><TR><TD><FONT POINT-SIZE="6"> </FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+tipo(): TipoPublicacion</TD></TR><TR><TD ALIGN="LEFT">+etiquetaPrecio(): String</TD></TR><TR><TD ALIGN="LEFT">+precioActual(p: Publicacion): BigDecimal</TD></TR><TR><TD ALIGN="LEFT">+permiteCompraInmediata(): boolean</TD></TR><TR><TD ALIGN="LEFT">+validarPuja(p, postor: Usuario, monto)</TD></TR><TR><TD ALIGN="LEFT">+validarCompra(p, comprador: Usuario)</TD></TR><TR><TD ALIGN="LEFT">+debeCerrarse(p, ahora): boolean</TD></TR></TABLE>>];
 TipoVentaBase [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#333333" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#fff2b3" ALIGN="CENTER"><I><B>TipoVentaBase</B></I></TD></TR><HR/><TR><TD><FONT POINT-SIZE="6"> </FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+validarPuja(p, postor, monto) {final}</TD></TR><TR><TD ALIGN="LEFT">+validarCompra(p, comprador)</TD></TR><TR><TD ALIGN="LEFT">+debeCerrarse(p, ahora): boolean</TD></TR><TR><TD ALIGN="LEFT"><I>#validarMonto(p, monto)</I></TD></TR></TABLE>>];
 VentaDirecta [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#333333" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#fff2b3" ALIGN="CENTER"><B>VentaDirecta</B></TD></TR><HR/><TR><TD><FONT POINT-SIZE="6"> </FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+precioActual(p): BigDecimal</TD></TR><TR><TD ALIGN="LEFT">+permiteCompraInmediata(): boolean</TD></TR><TR><TD ALIGN="LEFT">#validarMonto(p, monto)</TD></TR></TABLE>>];
 VentaPorOferta [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#333333" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#fff2b3" ALIGN="CENTER"><B>VentaPorOferta</B></TD></TR><HR/><TR><TD><FONT POINT-SIZE="6"> </FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+precioActual(p): BigDecimal</TD></TR><TR><TD ALIGN="LEFT">+permiteCompraInmediata(): boolean</TD></TR><TR><TD ALIGN="LEFT">#validarMonto(p, monto)</TD></TR></TABLE>>];
 Subasta [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#333333" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#fff2b3" ALIGN="CENTER"><B>Subasta</B></TD></TR><HR/><TR><TD ALIGN="LEFT">+INCREMENTO_MINIMO: BigDecimal {static}</TD></TR><HR/><TR><TD ALIGN="LEFT">+precioActual(p): BigDecimal</TD></TR><TR><TD ALIGN="LEFT">+permiteCompraInmediata(): boolean</TD></TR><TR><TD ALIGN="LEFT">+debeCerrarse(p, ahora): boolean</TD></TR><TR><TD ALIGN="LEFT">#validarMonto(p, monto)</TD></TR></TABLE>>];
 TipoVentaFactory [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#333333" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#d9f0f0" ALIGN="CENTER"><B>TipoVentaFactory</B></TD></TR><HR/><TR><TD ALIGN="LEFT">-ESTRATEGIAS: Map</TD></TR><HR/><TR><TD ALIGN="LEFT">+obtener(t: TipoPublicacion): TipoVenta {static}</TD></TR></TABLE>>];
 TipoPublicacion [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#333333" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#eeeeee" ALIGN="CENTER"><FONT POINT-SIZE="10">&lt;&lt;enumeration&gt;&gt;<BR/></FONT><B>TipoPublicacion</B></TD></TR><HR/><TR><TD ALIGN="LEFT">DIRECTA</TD></TR><TR><TD ALIGN="LEFT">OFERTA</TD></TR><TR><TD ALIGN="LEFT">SUBASTA</TD></TR></TABLE>>];
 Publicacion [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#333333" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#f6d9d5" ALIGN="CENTER"><B>Publicacion</B></TD></TR><HR/><TR><TD ALIGN="LEFT">-tipo: TipoPublicacion</TD></TR><TR><TD ALIGN="LEFT">-precio: BigDecimal</TD></TR><TR><TD ALIGN="LEFT">-fechaCierre: LocalDateTime</TD></TR><HR/><TR><TD ALIGN="LEFT">+getTipoVenta(): TipoVenta</TD></TR><TR><TD ALIGN="LEFT">+getPrecioActual(): BigDecimal</TD></TR></TABLE>>];
 TipoVentaBase -> TipoVenta [arrowhead=empty, style=dashed];
 VentaDirecta -> TipoVentaBase [arrowhead=empty];
 VentaPorOferta -> TipoVentaBase [arrowhead=empty];
 Subasta -> TipoVentaBase [arrowhead=empty];
 Publicacion -> TipoVenta [arrowhead=vee, style=dashed, label=" delega (Strategy) "];
 TipoVentaFactory -> TipoVenta [arrowhead=vee, style=dashed, label=" crea "];
 TipoVentaFactory -> TipoPublicacion [arrowhead=vee, style=dashed, label=" selecciona por "];
}
