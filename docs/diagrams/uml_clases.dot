digraph G {
 graph [rankdir=BT, nodesep=0.45, ranksep=0.8, fontname="Helvetica", bgcolor="white", pad=0.4, dpi=170, labelloc=t, fontsize=20, label=<<B>FEAR Clothes — Diagrama de clases UML (dominio, patrones Strategy y Factory)</B>>];
 node [shape=plain, fontname="Helvetica", fontsize=11];
 edge [fontname="Helvetica", fontsize=10, color="#333333"];
 Usuario [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#333333" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#dbe7f6" ALIGN="CENTER"><I><B>Usuario</B></I></TD></TR><HR/><TR><TD ALIGN="LEFT">-id: Long</TD></TR><TR><TD ALIGN="LEFT">-nombre: String</TD></TR><TR><TD ALIGN="LEFT">-email: String</TD></TR><TR><TD ALIGN="LEFT">-password: String</TD></TR><TR><TD ALIGN="LEFT">-activo: boolean</TD></TR><HR/><TR><TD ALIGN="LEFT"><I>+getRol(): String</I></TD></TR><TR><TD ALIGN="LEFT">+puedePublicar(): boolean</TD></TR><TR><TD ALIGN="LEFT">+getDescripcionPerfil(): String</TD></TR></TABLE>>];
 Comprador [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#333333" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#dbe7f6" ALIGN="CENTER"><B>Comprador</B></TD></TR><HR/><TR><TD><FONT POINT-SIZE="6"> </FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+getRol(): String</TD></TR></TABLE>>];
 Vendedor [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#333333" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#dbe7f6" ALIGN="CENTER"><B>Vendedor</B></TD></TR><HR/><TR><TD ALIGN="LEFT">-nombreTienda: String</TD></TR><HR/><TR><TD ALIGN="LEFT">+getRol(): String</TD></TR><TR><TD ALIGN="LEFT">+puedePublicar(): boolean</TD></TR></TABLE>>];
 Administrador [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#333333" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#dbe7f6" ALIGN="CENTER"><B>Administrador</B></TD></TR><HR/><TR><TD><FONT POINT-SIZE="6"> </FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+getRol(): String</TD></TR></TABLE>>];
 Prenda [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#333333" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#dcefdc" ALIGN="CENTER"><I><B>Prenda</B></I></TD></TR><HR/><TR><TD ALIGN="LEFT">-id: Long</TD></TR><TR><TD ALIGN="LEFT">-nombre: String</TD></TR><TR><TD ALIGN="LEFT">-descripcion: String</TD></TR><TR><TD ALIGN="LEFT">-color: String</TD></TR><TR><TD ALIGN="LEFT">-imagenUrl: String</TD></TR><TR><TD ALIGN="LEFT">-categoria: Categoria</TD></TR><TR><TD ALIGN="LEFT">-condicion: Condicion</TD></TR><HR/><TR><TD ALIGN="LEFT"><I>+getDetalleEspecifico(): String</I></TD></TR><TR><TD ALIGN="LEFT">+getResumen(): String</TD></TR></TABLE>>];
 Calzado [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#333333" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#dcefdc" ALIGN="CENTER"><B>Calzado</B></TD></TR><HR/><TR><TD ALIGN="LEFT">-silueta: String</TD></TR><HR/><TR><TD ALIGN="LEFT">+getDetalleEspecifico(): String</TD></TR></TABLE>>];
 Camiseta [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#333333" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#dcefdc" ALIGN="CENTER"><B>Camiseta</B></TD></TR><HR/><TR><TD ALIGN="LEFT">-tipoCuello: String</TD></TR><HR/><TR><TD ALIGN="LEFT">+getDetalleEspecifico(): String</TD></TR></TABLE>>];
 Chamarra [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#333333" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#dcefdc" ALIGN="CENTER"><B>Chamarra</B></TD></TR><HR/><TR><TD ALIGN="LEFT">-impermeable: Boolean</TD></TR><HR/><TR><TD ALIGN="LEFT">+getDetalleEspecifico(): String</TD></TR></TABLE>>];
 Marca [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#333333" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#eadcf3" ALIGN="CENTER"><B>Marca</B></TD></TR><HR/><TR><TD ALIGN="LEFT">-id: Long</TD></TR><TR><TD ALIGN="LEFT">-nombre: String</TD></TR><TR><TD ALIGN="LEFT">-pais: String</TD></TR><HR/><TR><TD><FONT POINT-SIZE="6"> </FONT></TD></TR></TABLE>>];
 Talla [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#333333" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#eadcf3" ALIGN="CENTER"><B>Talla</B></TD></TR><HR/><TR><TD ALIGN="LEFT">-id: Long</TD></TR><TR><TD ALIGN="LEFT">-etiqueta: String</TD></TR><HR/><TR><TD><FONT POINT-SIZE="6"> </FONT></TD></TR></TABLE>>];
 Publicacion [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#333333" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#f6d9d5" ALIGN="CENTER"><B>Publicacion</B></TD></TR><HR/><TR><TD ALIGN="LEFT">-id: Long</TD></TR><TR><TD ALIGN="LEFT">-tipo: TipoPublicacion</TD></TR><TR><TD ALIGN="LEFT">-precio: BigDecimal</TD></TR><TR><TD ALIGN="LEFT">-fechaCierre: LocalDateTime</TD></TR><TR><TD ALIGN="LEFT">-estado: EstadoPublicacion</TD></TR><TR><TD ALIGN="LEFT">-fechaCreacion: LocalDateTime</TD></TR><HR/><TR><TD ALIGN="LEFT">+getTipoVenta(): TipoVenta</TD></TR><TR><TD ALIGN="LEFT">+getPrecioActual(): BigDecimal</TD></TR><TR><TD ALIGN="LEFT">+getEtiquetaPrecio(): String</TD></TR><TR><TD ALIGN="LEFT">+getPujaMasAlta(): Puja</TD></TR><TR><TD ALIGN="LEFT">+agregarPuja(p: Puja)</TD></TR><TR><TD ALIGN="LEFT">+estaActiva(): boolean</TD></TR></TABLE>>];
 Puja [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#333333" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#fbe7c2" ALIGN="CENTER"><B>Puja</B></TD></TR><HR/><TR><TD ALIGN="LEFT">-id: Long</TD></TR><TR><TD ALIGN="LEFT">-monto: BigDecimal</TD></TR><TR><TD ALIGN="LEFT">-fecha: LocalDateTime</TD></TR><HR/><TR><TD><FONT POINT-SIZE="6"> </FONT></TD></TR></TABLE>>];
 Orden [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#333333" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#fbe7c2" ALIGN="CENTER"><B>Orden</B></TD></TR><HR/><TR><TD ALIGN="LEFT">-id: Long</TD></TR><TR><TD ALIGN="LEFT">-precioFinal: BigDecimal</TD></TR><TR><TD ALIGN="LEFT">-metodoPago: String</TD></TR><TR><TD ALIGN="LEFT">-fecha: LocalDateTime</TD></TR><HR/><TR><TD><FONT POINT-SIZE="6"> </FONT></TD></TR></TABLE>>];
 TipoVenta [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#333333" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#fff2b3" ALIGN="CENTER"><FONT POINT-SIZE="10">&lt;&lt;interface&gt;&gt;<BR/></FONT><B>TipoVenta</B></TD></TR><HR/><TR><TD><FONT POINT-SIZE="6"> </FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+tipo(): TipoPublicacion</TD></TR><TR><TD ALIGN="LEFT">+etiquetaPrecio(): String</TD></TR><TR><TD ALIGN="LEFT">+precioActual(p: Publicacion): BigDecimal</TD></TR><TR><TD ALIGN="LEFT">+permiteCompraInmediata(): boolean</TD></TR><TR><TD ALIGN="LEFT">+validarPuja(p, postor: Usuario, monto)</TD></TR><TR><TD ALIGN="LEFT">+validarCompra(p, comprador: Usuario)</TD></TR><TR><TD ALIGN="LEFT">+debeCerrarse(p, ahora): boolean</TD></TR></TABLE>>];
 TipoVentaBase [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#333333" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#fff2b3" ALIGN="CENTER"><I><B>TipoVentaBase</B></I></TD></TR><HR/><TR><TD><FONT POINT-SIZE="6"> </FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+validarPuja(p, postor, monto) {final}</TD></TR><TR><TD ALIGN="LEFT">+validarCompra(p, comprador)</TD></TR><TR><TD ALIGN="LEFT">+debeCerrarse(p, ahora): boolean</TD></TR><TR><TD ALIGN="LEFT"><I>#validarMonto(p, monto)</I></TD></TR></TABLE>>];
 VentaDirecta [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#333333" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#fff2b3" ALIGN="CENTER"><B>VentaDirecta</B></TD></TR><HR/><TR><TD><FONT POINT-SIZE="6"> </FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+precioActual(p): BigDecimal</TD></TR><TR><TD ALIGN="LEFT">+permiteCompraInmediata(): boolean</TD></TR><TR><TD ALIGN="LEFT">#validarMonto(p, monto)</TD></TR></TABLE>>];
 VentaPorOferta [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#333333" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#fff2b3" ALIGN="CENTER"><B>VentaPorOferta</B></TD></TR><HR/><TR><TD><FONT POINT-SIZE="6"> </FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+precioActual(p): BigDecimal</TD></TR><TR><TD ALIGN="LEFT">+permiteCompraInmediata(): boolean</TD></TR><TR><TD ALIGN="LEFT">#validarMonto(p, monto)</TD></TR></TABLE>>];
 Subasta [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#333333" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#fff2b3" ALIGN="CENTER"><B>Subasta</B></TD></TR><HR/><TR><TD ALIGN="LEFT">+INCREMENTO_MINIMO: BigDecimal {static}</TD></TR><HR/><TR><TD ALIGN="LEFT">+precioActual(p): BigDecimal</TD></TR><TR><TD ALIGN="LEFT">+permiteCompraInmediata(): boolean</TD></TR><TR><TD ALIGN="LEFT">+debeCerrarse(p, ahora): boolean</TD></TR><TR><TD ALIGN="LEFT">#validarMonto(p, monto)</TD></TR></TABLE>>];
 TipoVentaFactory [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#333333" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#d9f0f0" ALIGN="CENTER"><B>TipoVentaFactory</B></TD></TR><HR/><TR><TD ALIGN="LEFT">-ESTRATEGIAS: Map</TD></TR><HR/><TR><TD ALIGN="LEFT">+obtener(t: TipoPublicacion): TipoVenta {static}</TD></TR></TABLE>>];
 PrendaFactory [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#333333" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#d9f0f0" ALIGN="CENTER"><B>PrendaFactory</B></TD></TR><HR/><TR><TD><FONT POINT-SIZE="6"> </FONT></TD></TR><HR/><TR><TD ALIGN="LEFT">+crear(form, marca, talla): Prenda {static}</TD></TR></TABLE>>];
 Categoria [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#333333" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#eeeeee" ALIGN="CENTER"><FONT POINT-SIZE="10">&lt;&lt;enumeration&gt;&gt;<BR/></FONT><B>Categoria</B></TD></TR><HR/><TR><TD ALIGN="LEFT">CALZADO</TD></TR><TR><TD ALIGN="LEFT">CAMISETA</TD></TR><TR><TD ALIGN="LEFT">CHAMARRA</TD></TR></TABLE>>];
 Condicion [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#333333" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#eeeeee" ALIGN="CENTER"><FONT POINT-SIZE="10">&lt;&lt;enumeration&gt;&gt;<BR/></FONT><B>Condicion</B></TD></TR><HR/><TR><TD ALIGN="LEFT">NUEVA</TD></TR><TR><TD ALIGN="LEFT">COMO_NUEVA</TD></TR><TR><TD ALIGN="LEFT">USADA</TD></TR></TABLE>>];
 TipoPublicacion [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#333333" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#eeeeee" ALIGN="CENTER"><FONT POINT-SIZE="10">&lt;&lt;enumeration&gt;&gt;<BR/></FONT><B>TipoPublicacion</B></TD></TR><HR/><TR><TD ALIGN="LEFT">DIRECTA</TD></TR><TR><TD ALIGN="LEFT">OFERTA</TD></TR><TR><TD ALIGN="LEFT">SUBASTA</TD></TR></TABLE>>];
 EstadoPublicacion [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="3" COLOR="#333333" BGCOLOR="#ffffff"><TR><TD BGCOLOR="#eeeeee" ALIGN="CENTER"><FONT POINT-SIZE="10">&lt;&lt;enumeration&gt;&gt;<BR/></FONT><B>EstadoPublicacion</B></TD></TR><HR/><TR><TD ALIGN="LEFT">ACTIVA</TD></TR><TR><TD ALIGN="LEFT">VENDIDA</TD></TR><TR><TD ALIGN="LEFT">CERRADA</TD></TR></TABLE>>];
 Comprador -> Usuario [arrowhead=empty];
 Vendedor -> Usuario [arrowhead=empty];
 Administrador -> Usuario [arrowhead=empty];
 Calzado -> Prenda [arrowhead=empty];
 Camiseta -> Prenda [arrowhead=empty];
 Chamarra -> Prenda [arrowhead=empty];
 TipoVentaBase -> TipoVenta [arrowhead=empty, style=dashed];
 VentaDirecta -> TipoVentaBase [arrowhead=empty];
 VentaPorOferta -> TipoVentaBase [arrowhead=empty];
 Subasta -> TipoVentaBase [arrowhead=empty];
 Prenda -> Marca [arrowhead=vee, taillabel="*", headlabel="1", labeldistance=2.2, label=" marca "];
 Prenda -> Talla [arrowhead=vee, taillabel="*", headlabel="1", labeldistance=2.2, label=" talla "];
 Publicacion -> Prenda [arrowhead=vee, arrowtail=diamond, dir=both, taillabel="1", headlabel="1", labeldistance=2.2, label=" prenda "];
 Publicacion -> Usuario [arrowhead=vee, taillabel="*", headlabel="1", labeldistance=2.2, label=" vendedor "];
 Publicacion -> Puja [arrowhead=odiamond, dir=back, headlabel="0..*", taillabel="1", labeldistance=2.4, label=" pujas "];
 Puja -> Usuario [arrowhead=vee, taillabel="*", headlabel="1", labeldistance=2.2, label=" postor "];
 Orden -> Usuario [arrowhead=vee, taillabel="*", headlabel="1", labeldistance=2.2, label=" comprador "];
 Orden -> Publicacion [arrowhead=vee, taillabel="0..1", headlabel="1", labeldistance=2.2, label=" publicacion "];
 Publicacion -> TipoVenta [arrowhead=vee, style=dashed, label=" delega (Strategy) "];
 TipoVentaFactory -> TipoVenta [arrowhead=vee, style=dashed, label=" crea "];
 PrendaFactory -> Prenda [arrowhead=vee, style=dashed, label=" crea "];
 Prenda -> Categoria [arrowhead=vee, style=dashed];
 Prenda -> Condicion [arrowhead=vee, style=dashed];
 Publicacion -> TipoPublicacion [arrowhead=vee, style=dashed];
 Publicacion -> EstadoPublicacion [arrowhead=vee, style=dashed];
}
